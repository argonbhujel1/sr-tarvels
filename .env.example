# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
# Leave empty for local SQLite (easiest first run).
# For production use Neon:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/sr_all_service_hub?sslmode=require
DATABASE_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail SMTP (use App Password, never regular password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=srallservicenepal@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_DEFAULT_SENDER=SR All Service Hub Nepal <srallservicenepal@gmail.com>
MAIL_REPLY_TO=srallservicenepal@gmail.com

# Admin bootstrap (first run)
ADMIN_EMAIL=admin@srallservicenepal.com
ADMIN_PASSWORD=ChangeMeImmediately123!

# App
APP_NAME=SR All Service Hub Nepal
APP_URL=http://localhost:5000
DEFAULT_LANG=ne


# Production / Vercel
# FLASK_ENV=production
# SECRET_KEY=long-random-string
# DATABASE_URL=postgresql://user:pass@host/db  (Neon)
# APP_URL=https://your-domain.vercel.app
# MAIL_USERNAME=
# MAIL_PASSWORD=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Cloudinary — REQUIRED on Vercel (read-only filesystem)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_key
# CLOUDINARY_API_SECRET=your_secret

# Web Push (generate: python -c "from py_vapid import Vapid01; ...") or use web-push CLI
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIM_EMAIL=mailto:srallservicenepal@gmail.com
